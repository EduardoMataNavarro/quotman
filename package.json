{
  "name": "quotman",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "dev": "ng build --configuration development && wrangler dev",
    "preview": "ng build && wrangler dev",
    "deploy": "ng build && wrangler deploy",
    "test": "ng test",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.backend.json --noEmit && tsc -p tsconfig.backend-test.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate": "node --env-file=.dev.vars ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "tsx --env-file=.dev.vars backend/seed/run.ts"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.1",
    "@fontsource-variable/finlandica-text": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.12.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=24.15"
  },
  "type": "module"
}
